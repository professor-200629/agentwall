{
  // Agent Wall Worker: keeps the Groq API key off the client.
  // Deploy: cd worker && npx wrangler deploy
  // Secret:  npx wrangler secret put GROQ_API_KEY   (paste it in your terminal, never in code)
  "name": "agentwall-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    "MODEL": "qwen/qwen3.8-27b",
    "ALLOWED_ORIGINS": "https://professor-200629.github.io,https://localhost:8081"
  }
}
